@prefix atlas: <https://github.com/PtwoI/p2i-kg#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

atlas:ClaimShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path atlas:target ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:explanation ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path atlas:relation ],
        [ sh:in ( "documented" "structural" "pedagogical" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path atlas:basis ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path atlas:source ],
        [ sh:class atlas:Paper ;
            sh:minCount 1 ;
            sh:path atlas:evidence ] ;
    sh:targetClass atlas:Claim .

atlas:ComponentShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:summary ] ;
    sh:targetClass atlas:Component .

atlas:ConceptShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:summary ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:label ] ;
    sh:targetClass atlas:Concept .

atlas:ModelShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:summary ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:label ] ;
    sh:targetClass atlas:Model .

atlas:ObjectiveShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:summary ] ;
    sh:targetClass atlas:Objective .

atlas:PaperShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path atlas:url ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:summary ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:label ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:path atlas:reference_year ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path atlas:author ] ;
    sh:targetClass atlas:Paper .

atlas:TaskShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path atlas:summary ] ;
    sh:targetClass atlas:Task .

atlas:alternative_toShape a sh:NodeShape ;
    sh:or ( [ sh:class atlas:Model ] ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class atlas:Model ] ) ;
            sh:path atlas:alternative_to ] ;
    sh:targetSubjectsOf atlas:alternative_to .

atlas:applied_toShape a sh:NodeShape ;
    sh:or ( [ sh:class atlas:Model ] ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class atlas:Task ] ) ;
            sh:path atlas:applied_to ] ;
    sh:targetSubjectsOf atlas:applied_to .

atlas:documented_inShape a sh:NodeShape ;
    sh:or ( [ sh:class atlas:Model ] [ sh:class atlas:Concept ] [ sh:class atlas:Component ] [ sh:class atlas:Objective ] [ sh:class atlas:Task ] ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class atlas:Paper ] ) ;
            sh:path atlas:documented_in ] ;
    sh:targetSubjectsOf atlas:documented_in .

atlas:extendsShape a sh:NodeShape ;
    sh:or ( [ sh:class atlas:Model ] ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class atlas:Model ] ) ;
            sh:path atlas:extends ] ;
    sh:targetSubjectsOf atlas:extends .

atlas:has_componentShape a sh:NodeShape ;
    sh:or ( [ sh:class atlas:Model ] [ sh:class atlas:Component ] ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class atlas:Component ] ) ;
            sh:path atlas:has_component ] ;
    sh:targetSubjectsOf atlas:has_component .

atlas:subconcept_ofShape a sh:NodeShape ;
    sh:or ( [ sh:class atlas:Concept ] ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class atlas:Concept ] ) ;
            sh:path atlas:subconcept_of ] ;
    sh:targetSubjectsOf atlas:subconcept_of .

atlas:trained_withShape a sh:NodeShape ;
    sh:or ( [ sh:class atlas:Model ] ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class atlas:Objective ] ) ;
            sh:path atlas:trained_with ] ;
    sh:targetSubjectsOf atlas:trained_with .

atlas:usesShape a sh:NodeShape ;
    sh:or ( [ sh:class atlas:Model ] [ sh:class atlas:Component ] ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class atlas:Concept ] ) ;
            sh:path atlas:uses ] ;
    sh:targetSubjectsOf atlas:uses .


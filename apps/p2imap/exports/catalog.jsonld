2i-kg#objective/supervised"}},{"@id":"https://github.com/PtwoI/p2i-kg#claim/18ad6d09369af1b13b2cef04","@type":"Claim","basis":"documented","evidence":{"@id":"https://github.com/PtwoI/p2i-kg#paper/ddpm"},"explanation":"DDPM: 잠재 변수.","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://github.com/PtwoI/p2i-kg#paper/ddpm"},"locator":"Model architecture / training / experiments","relation":{"@id":"https://github.com/PtwoI/p2i-kg#uses"},"source":{"@id":"https://github.com/PtwoI/p2i-kg#model/ddpm"},"target":{"@id":"https://github.com/PtwoI/p2i-kg#concept/latent_variable"}},{"@id":"https://github.com/PtwoI/p2i-kg#component/conditioning_encoder","@type":"Component","documented_in":{"@id":"https://github.com/PtwoI/p2i-kg#paper/ldm"},"http://www.w3.org/2000/01/rdf-schema#label":"Conditioning encoder","label":"Conditioning encoder","summary":"조건 입력을 확산 네트워크가 사용할 문맥 표현으로 변환합니다."},{"@id":"https://github.com/PtwoI/p2i-kg#claim/14a88b54669504603ac94f23","@type":"Claim","basis":"documented","evidence":{"@id":"https://github.com/PtwoI/p2i-kg#paper/gat"},"explanation":"Graph Attention Network: 그래프 메시지 전달.","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://github.com/PtwoI/p2i-kg#paper/gat"},"locator":"Model architecture / training / experiments","relation":{"@id":"https://github.com/PtwoI/p2i-kg#uses"},"source":{"@id":"https://github.com/PtwoI/p2i-kg#model/gat"},"target":{"@id":"https://github.com/PtwoI/p2i-kg#concept/message_passing"}},{"@id":"https://github.com/PtwoI/p2i-kg#concept/relative_position","@type":"Concept","http://www.w3.org/2000/01/rdf-schema#label":"상대 위치 표현","label":"상대 위치 표현","subconcept_of":{"@id":"https://github.com/PtwoI/p2i-kg#concept/position"},"summary":"토큰 간 거리와 상대 위치를 표현하는 방법."},{"@id":"https://github.com/PtwoI/p2i-kg#concept/symmetric_reduction","@type":"Concept","documented_in":{"@id":"https://github.com/PtwoI/p2i-kg#paper/pointnet"},"http://www.w3.org/2000/01/rdf-schema#label":"Symmetric set reduction","label":"Symmetric set reduction","sub
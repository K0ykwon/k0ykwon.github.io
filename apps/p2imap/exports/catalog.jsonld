i-kg#concept/rl_policy_gradient"}},{"@id":"https://github.com/PtwoI/p2i-kg#claim/3a847954ce955061fe1cf74f","@type":"Claim","basis":"structural","evidence":{"@id":"https://github.com/PtwoI/p2i-kg#paper/deepsets"},"explanation":"합 풀링이 집합 함수의 불변 집계를 구현합니다.","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://github.com/PtwoI/p2i-kg#paper/deepsets"},"locator":"§2 Eq. 4","relation":{"@id":"https://github.com/PtwoI/p2i-kg#uses"},"source":{"@id":"https://github.com/PtwoI/p2i-kg#component/set_sum_pool"},"target":{"@id":"https://github.com/PtwoI/p2i-kg#concept/sum_decomposition"}},{"@id":"https://github.com/PtwoI/p2i-kg#model/dit","@type":"Model","applied_to":{"@id":"https://github.com/PtwoI/p2i-kg#task/conditional_image_generation"},"documented_in":{"@id":"https://github.com/PtwoI/p2i-kg#paper/dit"},"extends":[{"@id":"https://github.com/PtwoI/p2i-kg#model/ldm"},{"@id":"https://github.com/PtwoI/p2i-kg#model/vit"}],"family":"generative","has_component":[{"@id":"https://github.com/PtwoI/p2i-kg#component/latent_patch_embed"},{"@id":"https://github.com/PtwoI/p2i-kg#component/diffusion_time_embedding"},{"@id":"https://github.com/PtwoI/p2i-kg#component/class_embedding"},{"@id":"https://github.com/PtwoI/p2i-kg#component/adaln_block"},{"@id":"https://github.com/PtwoI/p2i-kg#component/adaln_modulation"},{"@id":"https://github.com/PtwoI/p2i-kg#component/self_attention"},{"@id":"https://github.com/PtwoI/p2i-kg#component/diffusion_output_head"}],"http://www.w3.org/2000/01/rdf-schema#label":"Diffusion Transformer","http://www.w3.org/2004/02/skos/core#altLabel":"DiT","label":"Diffusion Transformer","reference_year":2023,"runtime_id":"dit","runtime_note":"4채널 8×8 잠재를 2×2 패치 토큰으로 바꾸고 두 개의 16차원 adaLN 조건부 Transformer 블록으로 한 번의 클래스 조건 노이즈 예측을 실행합니다. VAE, 다단계 샘플러, classifier-free guidance 배치 결합, 대규모 학습과 사전학습 가중치는 포함하지 않습니다.","summary":"잠재 패치를 토큰화하고 시간·클래스 조건의 adaLN Transformer 블록으로 확산 노이즈를 예측합니다.","trained_with":{"@id":"https://github.com/PtwoI/p2i-kg#objective/latent_denoising"},"uses":
n_transformer"},"explanation":"상태 토큰에서 행동을 예측합니다.","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://github.com/PtwoI/p2i-kg#paper/decision_transformer"},"relation":{"@id":"https://github.com/PtwoI/p2i-kg#has_component"},"source":{"@id":"https://github.com/PtwoI/p2i-kg#model/decision_transformer"},"target":{"@id":"https://github.com/PtwoI/p2i-kg#component/rl_actor"}},{"@id":"https://github.com/PtwoI/p2i-kg#claim/0eae8c82d973555db248f8b0","@type":"Claim","basis":"documented","evidence":{"@id":"https://github.com/PtwoI/p2i-kg#paper/clip"},"explanation":"CLIP: 영상 분류.","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://github.com/PtwoI/p2i-kg#paper/clip"},"locator":"Model architecture / training / experiments","relation":{"@id":"https://github.com/PtwoI/p2i-kg#applied_to"},"source":{"@id":"https://github.com/PtwoI/p2i-kg#model/clip"},"target":{"@id":"https://github.com/PtwoI/p2i-kg#task/classification"}},{"@id":"https://github.com/PtwoI/p2i-kg#claim/a31e3ea5b56ea4e0904d08fb","@type":"Claim","basis":"documented","evidence":{"@id":"https://github.com/PtwoI/p2i-kg#paper/vit"},"explanation":"Vision Transformer: Self-Attention.","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://github.com/PtwoI/p2i-kg#paper/vit"},"locator":"Model architecture / training / experiments","relation":{"@id":"https://github.com/PtwoI/p2i-kg#uses"},"source":{"@id":"https://github.com/PtwoI/p2i-kg#model/vit"},"target":{"@id":"https://github.com/PtwoI/p2i-kg#concept/self_attention"}},{"@id":"https://github.com/PtwoI/p2i-kg#model/td3","@type":"Model","applied_to":{"@id":"https://github.com/PtwoI/p2i-kg#task/rl_control"},"documented_in":{"@id":"https://github.com/PtwoI/p2i-kg#paper/td3"},"extends":{"@id":"https://github.com/PtwoI/p2i-kg#model/ddpg"},"family":"reinforcement-learning","has_component":[{"@id":"https://github.com/PtwoI/p2i-kg#component/rl_actor"},{"@id":"https://github.com/PtwoI/p2i-kg#component/rl_q_head"}],"http://www.w3.org/2000/01/rdf-schema#label":"TD3","labe
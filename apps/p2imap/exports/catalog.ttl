<https://github.com/PtwoI/p2i-kg#model/simclr> a atlas:Model ;
    rdfs:label "SimCLR" ;
    skos:altLabel "Simple Contrastive Learning of Representations" ;
    atlas:applied_to <https://github.com/PtwoI/p2i-kg#task/classification> ;
    atlas:documented_in <https://github.com/PtwoI/p2i-kg#paper/simclr> ;

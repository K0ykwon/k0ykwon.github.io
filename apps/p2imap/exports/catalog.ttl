    atlas:summary "연속 좌표 방사장과 미분 가능한 볼륨 렌더링으로 새로운 시점을 합성한 원논문." ;
    atlas:url <https://arxiv.org/abs/2003.08934> .

<https://github.com/PtwoI/p2i-kg#paper/pointnet> a atlas:Paper ;
    rdfs:label "PointNet: Deep Learning on Point Sets for 3D Classification and Segmentation" ;
    atlas:author "Charles R. Qi",
        "Hao Su",
        "Kaichun Mo",
        "Leonidas J. Guibas" ;
    atlas:label "PointNet: Deep Learning on Point Sets for 3D Classification and Segmentation" ;
    atlas:reference_year 2017 ;
    atlas:summary "정렬되지 않은 원시 점 집합을 공유 점 특징과 대칭 함수로 직접 처리하는 3D 분류·분할 아키텍처 원논문." ;
    atlas:url <https://openaccess.thecvf.com/content_cvpr_2017/html/Qi_PointNet_Deep_Learning_CVPR_2017_paper.html> .

atlas:Model a owl:Class ;
    rdfs:label "Model" .

atlas:Concept a owl:Class ;
    rdfs:label "Concept" .

atlas:Component a owl:Class ;
    rdfs:label "Component" .

atlas:documented_in a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( atlas:Model atlas:Concept atlas:Component atlas:Objective atlas:Task ) ] ;
    rdfs:range atlas:Paper .

atlas:has_component a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( atlas:Model atlas:Component ) ] ;
    rdfs:range atlas:Component .

atlas:uses a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( atlas:Model atlas:Component ) ] ;
    rdfs:range atlas:Concept .

atlas:Claim a owl:Class ;
    rdfs:label "Claim" .

